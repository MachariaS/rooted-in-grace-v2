# Copy to .env for local development. On Netlify, set these under
# Site configuration → Environment variables. Never commit real values.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Paystack → Settings → API Keys & Webhooks (use the sk_test_ key until launch)
PAYSTACK_SECRET_KEY=sk_test_
