---
import logoSvg from '../assets/logo.svg?raw';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Inline the SVG so it inherits `color` (fill is currentColor) and sizing from CSS.
const svg = logoSvg.replace(
  '<svg ',
  `<svg class="logomark ${className}" role="img" aria-label="Rooted in Grace logo" `
);
---
<Fragment set:html={svg} />
