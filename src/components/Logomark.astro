---
import logoGreen from '../assets/logo_green.svg?raw';
import logoWhite from '../assets/logo_white.svg?raw';

interface Props {
  class?: string;
  variant?: 'green' | 'white';
}
const { class: className = '', variant = 'green' } = Astro.props;

// Inline the SVG so it can be sized with CSS.
const svg = (variant === 'white' ? logoWhite : logoGreen).replace(
  '<svg ',
  `<svg class="logomark ${className}" role="img" aria-label="Rooted in Grace logo" `
);
---
<Fragment set:html={svg} />
